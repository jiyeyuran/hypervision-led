---
import Layout from '../layouts/Layout.astro';

const language = 'en';
---

<Layout
  language={language}
  title="404 Not Found | HyperVision"
  description="The page you are looking for does not exist."
  path="/404"
>
  <section class="container-page py-20 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.12em] text-[var(--brand)]">404</p>
    <h1 class="mt-2 text-4xl font-bold">Page Not Found</h1>
    <p class="mt-3 text-[var(--text-subtle)]">The page you requested may have moved or been removed.</p>
    <a href="/" class="btn-primary mt-7">Back Home</a>
  </section>
</Layout>
