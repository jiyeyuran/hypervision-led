---
import Layout from '../layouts/Layout.astro';
import { messages } from '../lib/i18n';

const language = 'en';
const t = messages[language];
---

<Layout
  language={language}
  title="Contact HyperVision | LED Display Supplier"
  description="Contact HyperVision sales and engineering team for LED display projects."
  path="/contact"
>
  <section class="container-page py-14">
    <h1 class="text-4xl font-bold">{t.contact.title}</h1>
    <p class="mt-3 max-w-2xl text-[var(--text-subtle)]">{t.contact.description}</p>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      <article class="rounded-xl border border-[var(--border)] p-5">
        <p class="text-sm text-[var(--text-subtle)]">Email</p>
        <p class="mt-2 text-lg font-semibold">sales@hypervision-led.com</p>
      </article>
      <article class="rounded-xl border border-[var(--border)] p-5">
        <p class="text-sm text-[var(--text-subtle)]">Phone</p>
        <p class="mt-2 text-lg font-semibold">+86-755-0000-0000</p>
      </article>
    </div>
  </section>
</Layout>
