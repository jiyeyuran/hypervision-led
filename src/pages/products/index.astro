---
import Layout from '../../layouts/Layout.astro';
import { getProducts } from '../../lib/server/content';
import { pickLocalized } from '../../lib/page-data';

const language = 'en' as const;
const env = Astro.locals.runtime.env;
const products = await getProducts(env);
---

<Layout
  language={language}
  title="LED Products | HyperVision"
  description="Explore HyperVision LED product lines for indoor, outdoor and rental scenarios."
  path="/products"
>
  <section class="container-page py-14">
    <h1 class="text-4xl font-bold">Products</h1>
    <p class="mt-3 text-[var(--text-subtle)]">Professional LED display systems for multiple industries.</p>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        products.map((item) => (
          <article class="rounded-xl border border-[var(--border)] p-5">
            <h2 class="text-lg font-semibold">{pickLocalized(item, 'title', language)}</h2>
            <p class="mt-2 line-clamp-3 text-sm text-[var(--text-subtle)]">
              {pickLocalized(item, 'excerpt', language)}
            </p>
            <a href={`/products/${item.slug}`} class="mt-4 inline-block text-sm font-semibold text-[var(--brand)]">
              View details →
            </a>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
