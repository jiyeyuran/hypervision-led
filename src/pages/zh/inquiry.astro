---
import Layout from '../../layouts/Layout.astro';
import { messages } from '../../lib/i18n';
import { getTurnstileSiteKey } from '../../lib/config';

const language = 'zh';
const t = messages[language];
const renderedAt = Date.now();
const turnstileSiteKey = getTurnstileSiteKey();
---

<Layout
  language={language}
  title="提交询盘 | HyperVision LED"
  description="提交项目需求，获取 HyperVision 报价。"
  path="/zh/inquiry"
>
  <section class="container-page py-14">
    <h1 class="text-4xl font-bold">{t.inquiry.title}</h1>
    <p class="mt-3 max-w-2xl text-[var(--text-subtle)]">{t.inquiry.description}</p>
    <form
      id="inquiry-form-zh"
      class="mt-8 grid gap-4 rounded-xl border border-[var(--border)] p-6"
      enctype="multipart/form-data"
    >
      <input type="hidden" name="language" value="zh" />
      <input type="hidden" name="renderedAt" value={String(renderedAt)} />
      <label class="grid gap-1">
        <span class="text-sm">公司名称</span>
        <input name="company" class="rounded-lg border border-[var(--border)] px-3 py-2" required />
      </label>
      <label class="grid gap-1">
        <span class="text-sm">联系人</span>
        <input name="name" class="rounded-lg border border-[var(--border)] px-3 py-2" required />
      </label>
      <label class="grid gap-1">
        <span class="text-sm">邮箱</span>
        <input
          name="email"
          type="email"
          class="rounded-lg border border-[var(--border)] px-3 py-2"
          required
        />
      </label>
      <label class="grid gap-1">
        <span class="text-sm">国家</span>
        <input name="country" class="rounded-lg border border-[var(--border)] px-3 py-2" required />
      </label>
      <label class="grid gap-1">
        <span class="text-sm">需求说明</span>
        <textarea
          name="message"
          rows={6}
          class="rounded-lg border border-[var(--border)] px-3 py-2"
          required></textarea>
      </label>
      <label class="hidden">
        <span>Website</span>
        <input name="website" autocomplete="off" tabindex="-1" />
      </label>
      {
        turnstileSiteKey && (
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-theme="auto"
            data-action="inquiry"
            data-language="zh-cn"
            data-appearance="always"
            data-retry="auto"
            data-retry-interval="8000"
            data-refresh-expired="auto"
          />
        )
      }
      <p id="inquiry-webview-hint-zh" class="hidden text-sm text-amber-600">
        检测到微信浏览器或其他 App 内置浏览器。若人机验证一直加载不出来，请点击右上角"…"菜单，选择"在浏览器打开"后再提交。
      </p>
      <button class="btn-primary w-fit" type="submit">提交询盘</button>
      <p id="inquiry-result-zh" class="text-sm text-[var(--text-subtle)]"></p>
    </form>
  </section>
</Layout>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer></script>

<script>
  import { initInquiryForm } from '../../client/inquiry-form';
  initInquiryForm({
    formId: 'inquiry-form-zh',
    resultId: 'inquiry-result-zh',
    successMessage: '询盘已提交成功，我们将尽快联系您。',
    failFallback: '提交失败',
    captchaMessage: '请先完成人机验证再提交。',
    webviewHintId: 'inquiry-webview-hint-zh',
  });
</script>
