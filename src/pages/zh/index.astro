---
import Layout from '../../layouts/Layout.astro';
import { getLocalizedPath, messages } from '../../lib/i18n';
import { visualAssets } from '../../lib/visuals';

const language = 'zh';
const t = messages[language];
---

<Layout
  language={language}
  title="HyperVision LED | 工业级 LED 显示制造商"
  description="面向零售、活动、交通和智慧城市项目的工业级 LED 显示系统。"
  path="/zh"
>
  <section class="container-page py-12">
    <div class="image-card relative h-[460px]">
      <img src={visualAssets.hero} alt="LED 显示项目大图" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 to-black/25" />
      <div class="absolute inset-0 flex items-center">
        <div class="px-8 text-white md:px-12">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.12em] text-blue-200">B2B LED Display</p>
          <h1 class="max-w-3xl text-4xl font-bold leading-tight md:text-5xl">{t.home.heroTitle}</h1>
          <p class="mt-5 max-w-3xl text-lg text-white/85">{t.home.heroDescription}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={getLocalizedPath('/inquiry', language)} class="btn-primary">{t.home.ctaPrimary}</a>
            <a href={getLocalizedPath('/products', language)} class="rounded-lg border border-white/50 bg-white/10 px-5 py-3 font-semibold text-white">
              {t.home.ctaSecondary}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page pb-12">
    <h2 class="text-3xl font-bold">场景图集</h2>
    <p class="mt-2 text-[var(--text-subtle)]">强化图片展示：商业、展览、控制室、户外广告等应用场景。</p>
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {
        visualAssets.scenes.slice(0, 3).map((image, index) => (
          <article class="image-card">
            <img src={image} alt={`LED 场景图 ${index + 1}`} loading="lazy" class="h-56" />
          </article>
        ))
      }
    </div>
  </section>

  <section class="container-page pb-18">
    <div class="grid gap-6 md:grid-cols-2">
      <article class="image-card h-72">
        <img src={visualAssets.factory} alt="工厂生产线" loading="lazy" />
      </article>
      <article class="rounded-xl border border-[var(--border)] p-6">
        <h3 class="text-2xl font-semibold">工厂可视化实力</h3>
        <p class="mt-3 text-[var(--text-subtle)]">
          参考头部外贸网站，我们增加了更高密度的实拍图：产线、老化测试、交付案例，提升海外客户信任度。
        </p>
      </article>
    </div>
  </section>
</Layout>
