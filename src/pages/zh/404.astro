---
import Layout from '../../layouts/Layout.astro';

const language = 'zh';
---

<Layout
  language={language}
  title="404 页面不存在 | HyperVision"
  description="您访问的页面不存在。"
  path="/zh/404"
>
  <section class="container-page py-20 text-center">
    <h1 class="text-4xl font-bold">页面不存在</h1>
    <a href="/zh" class="btn-primary mt-7">返回首页</a>
  </section>
</Layout>
