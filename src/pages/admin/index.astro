---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  language="en"
  title="Admin | Inquiry Management"
  description="Manage inquiry pipeline with Cloudflare Access."
  path="/admin"
>
  <section class="container-page py-14">
    <h1 class="text-3xl font-bold">Inquiry Management</h1>
    <p class="mt-2 text-sm text-[var(--text-subtle)]">
      This page should be protected by Cloudflare Access policy.
    </p>
    <form id="filter-form" class="mt-6 grid gap-3 rounded-xl border border-[var(--border)] p-4 md:grid-cols-5">
      <input name="keyword" placeholder="Search..." class="rounded border border-[var(--border)] px-3 py-2" />
      <select name="status" class="rounded border border-[var(--border)] px-3 py-2">
        <option value="">All Status</option>
        <option value="new">New</option>
        <option value="contacted">Contacted</option>
        <option value="qualified">Qualified</option>
        <option value="closed">Closed</option>
        <option value="spam">Spam</option>
      </select>
      <input name="dateFrom" type="date" class="rounded border border-[var(--border)] px-3 py-2" />
      <input name="dateTo" type="date" class="rounded border border-[var(--border)] px-3 py-2" />
      <button class="btn-primary" type="submit">Filter</button>
    </form>

    <div class="mt-4 flex gap-3">
      <a class="rounded border border-[var(--border)] px-3 py-2 text-sm" href="/api/admin/inquiries/export">Export CSV</a>
      <a class="rounded border border-[var(--border)] px-3 py-2 text-sm" href="/api/admin/me">Check Access</a>
    </div>

    <div id="table" class="mt-6 overflow-x-auto rounded-xl border border-[var(--border)]"></div>
  </section>
</Layout>

<script>
  import { initAdminInquiryList } from '../../client/admin-inquiry-list';
  initAdminInquiryList();
</script>
