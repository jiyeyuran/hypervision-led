---
import Layout from '../../../layouts/Layout.astro';

const id = Astro.params.id;
---

<Layout
  language="en"
  title={`Inquiry ${id} | Admin`}
  description="Inquiry detail panel for status workflow and notes."
  path={`/admin/inquiries/${id}`}
>
  <section class="container-page py-14">
    <h1 class="text-3xl font-bold">Inquiry Detail</h1>
    <p class="mt-2 text-sm text-[var(--text-subtle)]">ID: {id}</p>

    <div id="admin-auth-banner" class="mt-6"></div>

    <div
      id="detail"
      class="mt-6 rounded-xl border border-[var(--border)] p-6"
      data-admin-protected
    >
    </div>
    <form id="status-form" class="mt-4 flex gap-3" data-admin-protected>
      <select name="status" class="rounded border border-[var(--border)] px-3 py-2">
        <option value="new">new</option>
        <option value="contacted">contacted</option>
        <option value="qualified">qualified</option>
        <option value="closed">closed</option>
        <option value="spam">spam</option>
      </select>
      <input
        name="reason"
        placeholder="Reason"
        class="rounded border border-[var(--border)] px-3 py-2"
      />
      <button class="btn-primary" type="submit">Update Status</button>
    </form>
    <form id="note-form" class="mt-3 flex gap-3" data-admin-protected>
      <input
        name="content"
        placeholder="Add note..."
        class="w-full rounded border border-[var(--border)] px-3 py-2"
      />
      <button class="btn-primary" type="submit">Add Note</button>
    </form>
  </section>
</Layout>

<script>
  import { initAdminAuthGate } from '../../../client/admin-auth';
  initAdminAuthGate({
    bannerId: 'admin-auth-banner',
    protectedSelectors: ['[data-admin-protected]'],
  });
</script>

<script is:inline define:vars={{ id }}>
  /** @typedef {{ inquiry: any; notes: any[]; statusLogs: any[] }} InquiryDetail */
  const detail = document.getElementById('detail');
  const statusForm = /** @type {HTMLFormElement | null} */ (document.getElementById('status-form'));
  const noteForm = /** @type {HTMLFormElement | null} */ (document.getElementById('note-form'));

  async function load() {
    if (!detail) return;
    const response = await fetch(`/api/admin/inquiries/${id}`);
    const payload = await response.json();
    if (!response.ok) {
      detail.innerHTML = `<p class="text-red-600">${payload.message ?? 'Failed to load detail'}</p>`;
      return;
    }
    /** @type {InquiryDetail} */
    const { inquiry, notes, statusLogs } = payload.data;
    detail.innerHTML = `
      <h2 class="text-xl font-semibold">${inquiry.company} / ${inquiry.name}</h2>
      <p class="mt-2 text-sm text-[var(--text-subtle)]">${inquiry.email} | ${inquiry.country}</p>
      <p class="mt-3">${inquiry.message}</p>
      <h3 class="mt-6 font-semibold">Notes</h3>
      <ul class="mt-2 space-y-2">${notes
        .map((n) => `<li class="text-sm">${n.content} (${n.created_by})</li>`)
        .join('')}</ul>
      <h3 class="mt-6 font-semibold">Status Logs</h3>
      <ul class="mt-2 space-y-2">${statusLogs.map((l) => `<li class="text-sm">${l.old_status} -> ${l.new_status} (${l.changed_by})</li>`).join('')}</ul>
    `;
  }

  statusForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const body = JSON.stringify(Object.fromEntries(new FormData(statusForm)));
    await fetch(`/api/admin/inquiries/${id}/status`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body,
    });
    load();
  });

  noteForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const body = JSON.stringify(Object.fromEntries(new FormData(noteForm)));
    await fetch(`/api/admin/inquiries/${id}/notes`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body,
    });
    noteForm.reset();
    load();
  });

  load();
</script>
