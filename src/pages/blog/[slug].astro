---
import Layout from '../../layouts/Layout.astro';
import { getBlogBySlug } from '../../lib/server/content';
import { pickLocalized } from '../../lib/page-data';
import { getWorkerEnv } from '../../lib/server/worker-env';
import { renderMarkdown } from '../../lib/server/markdown';

const language = 'en' as const;
const slug = Astro.params.slug ?? '';
const env = getWorkerEnv();
const post = await getBlogBySlug(env, slug);

if (!post) {
  return Astro.redirect('/404');
}

const html = renderMarkdown(pickLocalized(post, 'content', language));
---

<Layout
  language={language}
  title={`${pickLocalized(post, 'title', language)} | HyperVision Blog`}
  description={pickLocalized(post, 'excerpt', language)}
  path={`/blog/${slug}`}
>
  <section class="container-page py-10 md:py-14">
    <a href="/blog" class="text-sm text-[var(--text-subtle)] hover:text-[var(--brand)]"
      >← Back to blog</a
    >
    <h1 class="mt-3 text-3xl font-bold md:text-4xl">{pickLocalized(post, 'title', language)}</h1>
    <p class="mt-2 text-xs text-[var(--text-subtle)]">{post.published_at.slice(0, 10)}</p>
    {
      post.cover_image && (
        <div class="image-card mt-6 h-60 md:h-80">
          <img src={post.cover_image} alt={pickLocalized(post, 'title', language)} loading="lazy" />
        </div>
      )
    }
    <article class="prose prose-neutral mt-6 max-w-none">
      <div set:html={html} />
    </article>
  </section>
</Layout>
