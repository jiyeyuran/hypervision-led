---
import Layout from '../layouts/Layout.astro';
import { messages } from '../lib/i18n';

const language = 'en';
const t = messages[language];
const renderedAt = Date.now();
---

<Layout
  language={language}
  title="Send Inquiry | HyperVision LED"
  description="Submit project requirements and receive a quotation from HyperVision."
  path="/inquiry"
>
  <section class="container-page py-14">
    <h1 class="text-4xl font-bold">{t.inquiry.title}</h1>
    <p class="mt-3 max-w-2xl text-[var(--text-subtle)]">{t.inquiry.description}</p>

    <form id="inquiry-form" class="mt-8 grid gap-4 rounded-xl border border-[var(--border)] p-6" enctype="multipart/form-data">
      <input type="hidden" name="language" value="en" />
      <input type="hidden" name="renderedAt" value={String(renderedAt)} />
      <label class="grid gap-1">
        <span class="text-sm">Company</span>
        <input name="company" class="rounded-lg border border-[var(--border)] px-3 py-2" required />
      </label>
      <label class="grid gap-1">
        <span class="text-sm">Name</span>
        <input name="name" class="rounded-lg border border-[var(--border)] px-3 py-2" required />
      </label>
      <label class="grid gap-1">
        <span class="text-sm">Email</span>
        <input name="email" type="email" class="rounded-lg border border-[var(--border)] px-3 py-2" required />
      </label>
      <label class="grid gap-1">
        <span class="text-sm">Country</span>
        <input name="country" class="rounded-lg border border-[var(--border)] px-3 py-2" required />
      </label>
      <label class="grid gap-1">
        <span class="text-sm">Message</span>
        <textarea name="message" rows={6} class="rounded-lg border border-[var(--border)] px-3 py-2" required />
      </label>
      <label class="hidden">
        <span>Website</span>
        <input name="website" autocomplete="off" tabindex="-1" />
      </label>
      <label class="grid gap-1">
        <span class="text-sm">Attachment (optional, max 5MB)</span>
        <input name="attachment" type="file" />
      </label>
      <button class="btn-primary w-fit" type="submit">Submit Inquiry</button>
      <p id="inquiry-result" class="text-sm text-[var(--text-subtle)]"></p>
    </form>
  </section>
</Layout>

<script>
  const form = document.getElementById('inquiry-form');
  const result = document.getElementById('inquiry-result');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const target = event.currentTarget;
    if (!(target instanceof HTMLFormElement)) return;
    const body = new FormData(target);
    const response = await fetch('/api/inquiries', {
      method: 'POST',
      body,
    });
    const payload = await response.json();
    if (!response.ok) {
      if (result) result.textContent = payload.message ?? 'Submit failed.';
      return;
    }
    if (result) result.textContent = 'Inquiry submitted successfully. Our team will contact you soon.';
    target.reset();
  });
</script>
