---
import Layout from '../layouts/Layout.astro';
import { messages } from '../lib/i18n';
import { getTurnstileSiteKey } from '../lib/config';

const language = 'en';
const t = messages[language];
const renderedAt = Date.now();
const turnstileSiteKey = getTurnstileSiteKey();
---

<Layout
  language={language}
  title="Send Inquiry | HyperVision LED"
  description="Submit project requirements and receive a quotation from HyperVision."
  path="/inquiry"
>
  <section class="container-page py-14">
    <h1 class="text-4xl font-bold">{t.inquiry.title}</h1>
    <p class="mt-3 max-w-2xl text-[var(--text-subtle)]">{t.inquiry.description}</p>

    <form
      id="inquiry-form"
      class="mt-8 grid gap-4 rounded-xl border border-[var(--border)] p-6"
      enctype="multipart/form-data"
    >
      <input type="hidden" name="language" value="en" />
      <input type="hidden" name="renderedAt" value={String(renderedAt)} />
      <label class="grid gap-1">
        <span class="text-sm">Company</span>
        <input name="company" class="rounded-lg border border-[var(--border)] px-3 py-2" required />
      </label>
      <label class="grid gap-1">
        <span class="text-sm">Name</span>
        <input name="name" class="rounded-lg border border-[var(--border)] px-3 py-2" required />
      </label>
      <label class="grid gap-1">
        <span class="text-sm">Email</span>
        <input
          name="email"
          type="email"
          class="rounded-lg border border-[var(--border)] px-3 py-2"
          required
        />
      </label>
      <label class="grid gap-1">
        <span class="text-sm">Country</span>
        <input name="country" class="rounded-lg border border-[var(--border)] px-3 py-2" required />
      </label>
      <label class="grid gap-1">
        <span class="text-sm">Message</span>
        <textarea
          name="message"
          rows={6}
          class="rounded-lg border border-[var(--border)] px-3 py-2"
          required></textarea>
      </label>
      <label class="hidden">
        <span>Website</span>
        <input name="website" autocomplete="off" tabindex="-1" />
      </label>
      <label class="grid gap-1">
        <span class="text-sm">Attachment (optional, max 5MB)</span>
        <input name="attachment" type="file" />
      </label>
      {
        turnstileSiteKey && (
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-theme="auto"
            data-action="inquiry"
          />
        )
      }
      <button class="btn-primary w-fit" type="submit">Submit Inquiry</button>
      <p id="inquiry-result" class="text-sm text-[var(--text-subtle)]"></p>
    </form>
  </section>
</Layout>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer></script>

<script>
  import { initInquiryForm } from '../client/inquiry-form';
  initInquiryForm({
    formId: 'inquiry-form',
    resultId: 'inquiry-result',
    successMessage: 'Inquiry submitted successfully. Our team will contact you soon.',
    failFallback: 'Submit failed.',
    captchaMessage: 'Please complete the verification challenge before submitting.',
  });
</script>
