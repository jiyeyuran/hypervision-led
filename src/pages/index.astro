---
import Layout from '../layouts/Layout.astro';
import { getLocalizedPath, messages } from '../lib/i18n';

const language = 'en';
const t = messages[language];
---

<Layout
  language={language}
  title="HyperVision LED | Industrial LED Display Manufacturer"
  description="Industrial LED display systems for retail, event, transport and smart city projects."
  path="/"
>
  <section class="container-page py-18">
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.12em] text-[var(--brand)]">B2B LED Display</p>
    <h1 class="max-w-3xl text-4xl font-bold leading-tight md:text-5xl">{t.home.heroTitle}</h1>
    <p class="mt-5 max-w-3xl text-lg text-[var(--text-subtle)]">{t.home.heroDescription}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={getLocalizedPath('/inquiry', language)} class="btn-primary">{t.home.ctaPrimary}</a>
      <a href={getLocalizedPath('/products', language)} class="rounded-lg border border-[var(--border)] px-5 py-3 font-semibold">{t.home.ctaSecondary}</a>
    </div>
  </section>

  <section class="container-page grid gap-6 pb-18 md:grid-cols-3">
    <article class="rounded-xl border border-[var(--border)] p-6">
      <h2 class="text-lg font-semibold">OEM & ODM</h2>
      <p class="mt-3 text-sm text-[var(--text-subtle)]">Flexible structure, cabinet design, and control system options.</p>
    </article>
    <article class="rounded-xl border border-[var(--border)] p-6">
      <h2 class="text-lg font-semibold">Quality Control</h2>
      <p class="mt-3 text-sm text-[var(--text-subtle)]">100% aging test, waterproof validation, and strict production QA process.</p>
    </article>
    <article class="rounded-xl border border-[var(--border)] p-6">
      <h2 class="text-lg font-semibold">Global Delivery</h2>
      <p class="mt-3 text-sm text-[var(--text-subtle)]">Door-to-door logistics, remote commissioning, and local partner support.</p>
    </article>
  </section>
</Layout>
