---
import { getLocalizedPath, messages } from '../lib/i18n';
import type { Language } from '../lib/i18n';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const t = messages[language];

const navItems = [
  { href: getLocalizedPath('/', language), label: t.nav.home },
  { href: getLocalizedPath('/about', language), label: t.nav.about },
  { href: getLocalizedPath('/products', language), label: t.nav.products },
  { href: getLocalizedPath('/blog', language), label: t.nav.blog },
  { href: getLocalizedPath('/contact', language), label: t.nav.contact },
  { href: getLocalizedPath('/inquiry', language), label: t.nav.inquiry },
];

const otherLangLabel = language === 'en' ? '中文' : 'EN';
const otherLangHref = language === 'en' ? '/zh/' : '/';
---

<header class="site-header sticky top-0 z-50 border-b border-[var(--border)] bg-white">
  <div class="container-page flex items-center justify-between py-3 md:py-4">
    <a
      href={getLocalizedPath('/', language)}
      class="flex items-center gap-2 text-lg font-semibold md:text-xl"
    >
      <span
        class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-[var(--brand)] text-white"
        >HV</span
      >
      <span>{t.siteName}</span>
    </a>

    <nav class="hidden items-center gap-5 text-sm text-[var(--text-subtle)] md:flex">
      {
        navItems.map((item) => (
          <a href={item.href} class="hover:text-[var(--brand)]">
            {item.label}
          </a>
        ))
      }
      <a
        href={otherLangHref}
        class="rounded-md border border-[var(--border)] px-2 py-1 text-xs font-semibold hover:border-[var(--brand)] hover:text-[var(--brand)]"
      >
        {otherLangLabel}
      </a>
      <a href={getLocalizedPath('/inquiry', language)} class="btn-primary !px-4 !py-2 !text-sm">
        {t.home.ctaPrimary}
      </a>
    </nav>

    <button
      type="button"
      id="mobile-menu-toggle"
      class="menu-toggle inline-flex h-10 w-10 items-center justify-center rounded-md border border-[var(--border)] md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg
        class="menu-icon menu-icon-open"
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
      <svg
        class="menu-icon menu-icon-close"
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="6" y1="18" x2="18" y2="6"></line>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="mobile-menu border-t border-[var(--border)] bg-white md:hidden"
    hidden
  >
    <nav class="container-page flex flex-col py-3 text-sm">
      {
        navItems.map((item) => (
          <a href={item.href} class="border-b border-[var(--border)] py-3 last:border-b-0">
            {item.label}
          </a>
        ))
      }
      <div class="mt-3 flex items-center gap-3">
        <a
          href={otherLangHref}
          class="rounded-md border border-[var(--border)] px-3 py-2 text-xs font-semibold"
        >
          {otherLangLabel}
        </a>
        <a
          href={getLocalizedPath('/inquiry', language)}
          class="btn-primary flex-1 !px-4 !py-2 !text-sm"
        >
          {t.home.ctaPrimary}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .menu-toggle {
    background: #fff;
    cursor: pointer;
    -webkit-tap-highlight-color: rgba(31, 122, 255, 0.2);
    touch-action: manipulation;
  }
  .menu-toggle > * {
    pointer-events: none;
  }
  .menu-icon-close {
    display: none;
  }
  .site-header[data-menu-open='true'] .menu-icon-open {
    display: none;
  }
  .site-header[data-menu-open='true'] .menu-icon-close {
    display: inline-block;
  }
</style>

<script is:inline>
  (function () {
    function init() {
      const header = document.querySelector('.site-header');
      const toggle = document.getElementById('mobile-menu-toggle');
      const menu = document.getElementById('mobile-menu');
      if (!header || !toggle || !menu) return;
      if (toggle.dataset.bound === '1') return;
      toggle.dataset.bound = '1';

      function setOpen(open) {
        if (open) {
          menu.removeAttribute('hidden');
          header.setAttribute('data-menu-open', 'true');
          toggle.setAttribute('aria-expanded', 'true');
        } else {
          menu.setAttribute('hidden', '');
          header.setAttribute('data-menu-open', 'false');
          toggle.setAttribute('aria-expanded', 'false');
        }
      }

      toggle.addEventListener('click', function (event) {
        event.preventDefault();
        const isOpen = header.getAttribute('data-menu-open') === 'true';
        setOpen(!isOpen);
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth >= 768) setOpen(false);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
