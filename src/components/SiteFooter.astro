---
import { getLocalizedPath, messages } from '../lib/i18n';
import type { Language } from '../lib/i18n';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const t = messages[language];
---

<footer class="mt-20 border-t border-[var(--border)] bg-[var(--bg-soft)]">
  <div class="container-page py-10 text-sm text-[var(--text-subtle)]">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <p>© {new Date().getFullYear()} HyperVision LED. All rights reserved.</p>
      <div class="flex gap-4">
        <a href={getLocalizedPath('/about', language)}>{t.nav.about}</a>
        <a href={getLocalizedPath('/contact', language)}>{t.nav.contact}</a>
        <a href={getLocalizedPath('/inquiry', language)}>{t.nav.inquiry}</a>
      </div>
    </div>
  </div>
</footer>
