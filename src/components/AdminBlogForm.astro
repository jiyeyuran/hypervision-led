---
interface Props {
  mode: 'create' | 'edit';
  initialSlug?: string;
  initialTitleEn?: string;
  initialTitleZh?: string;
  initialExcerptEn?: string;
  initialExcerptZh?: string;
  initialContentEn?: string;
  initialContentZh?: string;
  initialCover?: string | null;
  initialPublished?: boolean;
  initialPublishedAt?: string | null;
}

const {
  initialSlug = '',
  initialTitleEn = '',
  initialTitleZh = '',
  initialExcerptEn = '',
  initialExcerptZh = '',
  initialContentEn = '',
  initialContentZh = '',
  initialCover = '',
  initialPublished = true,
  initialPublishedAt = '',
} = Astro.props;
---

<form id="blog-form" class="mt-6 grid gap-5">
  <div class="grid gap-4 md:grid-cols-2">
    <label class="grid gap-1">
      <span class="text-xs font-semibold tracking-wide text-[var(--text-subtle)] uppercase"
        >Title (EN) *</span
      >
      <input
        id="title-en"
        type="text"
        class="rounded border border-[var(--border)] px-3 py-2"
        value={initialTitleEn}
        required
      />
    </label>
    <label class="grid gap-1">
      <span class="text-xs font-semibold tracking-wide text-[var(--text-subtle)] uppercase"
        >标题 (ZH) *</span
      >
      <input
        id="title-zh"
        type="text"
        class="rounded border border-[var(--border)] px-3 py-2"
        value={initialTitleZh}
        required
      />
    </label>
  </div>

  <label class="grid gap-1">
    <span class="text-xs font-semibold tracking-wide text-[var(--text-subtle)] uppercase"
      >Slug (URL) *</span
    >
    <input
      id="slug"
      type="text"
      class="rounded border border-[var(--border)] px-3 py-2 font-mono text-sm"
      value={initialSlug}
      placeholder="kebab-case-slug"
      required
    />
    <span class="text-xs text-[var(--text-subtle)]">Lowercase letters, digits and hyphens.</span>
  </label>

  <div class="grid gap-4 md:grid-cols-2">
    <label class="grid gap-1">
      <span class="text-xs font-semibold tracking-wide text-[var(--text-subtle)] uppercase"
        >Excerpt (EN) *</span
      >
      <textarea
        id="excerpt-en"
        rows="3"
        class="rounded border border-[var(--border)] px-3 py-2"
        required>{initialExcerptEn}</textarea
      >
    </label>
    <label class="grid gap-1">
      <span class="text-xs font-semibold tracking-wide text-[var(--text-subtle)] uppercase"
        >摘要 (ZH) *</span
      >
      <textarea
        id="excerpt-zh"
        rows="3"
        class="rounded border border-[var(--border)] px-3 py-2"
        required>{initialExcerptZh}</textarea
      >
    </label>
  </div>

  <div class="grid gap-2">
    <span class="text-xs font-semibold tracking-wide text-[var(--text-subtle)] uppercase"
      >Cover Image</span
    >
    <div class="flex flex-wrap items-center gap-3">
      <input
        id="cover-image"
        type="text"
        class="min-w-0 flex-1 rounded border border-[var(--border)] px-3 py-2 font-mono text-xs"
        value={initialCover ?? ''}
        placeholder="https://... or /api/public/files/..."
      />
      <label
        class="cursor-pointer rounded border border-[var(--border)] px-3 py-2 text-sm font-semibold hover:border-[var(--brand)] hover:text-[var(--brand)]"
      >
        Upload
        <input id="cover-file" type="file" accept="image/*" class="hidden" />
      </label>
    </div>
    <img
      id="cover-preview"
      src={initialCover ?? ''}
      alt=""
      class:list={['h-32 w-56 rounded object-cover', !initialCover && 'hidden']}
    />
  </div>

  <div class="grid gap-2">
    <span class="text-xs font-semibold tracking-wide text-[var(--text-subtle)] uppercase"
      >Content (EN) *</span
    >
    <textarea id="content-en" rows="12" required>{initialContentEn}</textarea>
  </div>

  <div class="grid gap-2">
    <span class="text-xs font-semibold tracking-wide text-[var(--text-subtle)] uppercase"
      >正文 (ZH) *</span
    >
    <textarea id="content-zh" rows="12" required>{initialContentZh}</textarea>
  </div>

  <div class="grid gap-4 rounded-xl border border-[var(--border)] p-4 md:grid-cols-3">
    <label class="flex items-center gap-2 text-sm">
      <input id="is-published" type="checkbox" checked={initialPublished} class="h-4 w-4" />
      <span>Published</span>
    </label>
    <label class="grid gap-1 text-sm md:col-span-2">
      <span class="text-xs font-semibold tracking-wide text-[var(--text-subtle)] uppercase"
        >Published At</span
      >
      <input
        id="published-at"
        type="datetime-local"
        class="rounded border border-[var(--border)] px-3 py-2"
        value={initialPublishedAt ?? ''}
      />
    </label>
  </div>

  <div class="flex items-center gap-3">
    <button id="submit-btn" type="submit" class="btn-primary">Save</button>
    <a
      href="/admin/blog"
      class="rounded-lg border border-[var(--border)] px-4 py-2 text-sm font-semibold">Cancel</a
    >
    <p id="form-status" class="text-sm text-[var(--text-subtle)]"></p>
  </div>
</form>
